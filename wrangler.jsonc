{
  "name": "portail-xgs",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /aureo/ n'est pas un fichier du portail : ces adresses passent d'abord
    // par le worker, qui les relaie vers Auréo.
    "run_worker_first": ["/aureo", "/aureo/*"]
  },
  "vars": {
    // Adresse actuelle d'Auréo. A remplacer par l'adresse reelle de son
    // deploiement Cloudflare (Workers & Pages > aureo-app).
    "AUREO_ORIGIN": "https://aureo-app.A-REMPLACER.workers.dev"
  }
}
